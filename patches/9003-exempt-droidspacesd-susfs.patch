# 9003 (OPSIONAL) - Exempt domain `droidspacesd` dari SUSFS "hide sus mounts
# for non-su procs": daemon/kontainer DroidSpaces melihat mount tree asli,
# root-hiding app lain tetap bekerja. Tergantung 9005: fungsi
# susfs_is_current_droidspaces_domain() disediakan kernel/feature/ksu_susfs_compat.c.
# Tanpa patch ini: biarkan toggle susfs pada posisi OFF (default kernel ini memang OFF).
diff --git a/fs/namespace.c b/fs/namespace.c
index 025b373..073ed5b 100644
--- a/fs/namespace.c
+++ b/fs/namespace.c
@@ -4993,11 +4993,17 @@ fs_initcall(init_fs_namespace_sysctls);
 
 #ifdef CONFIG_KSU_SUSFS
 /* - To retrieve the non sus mnt_id from mount */
+extern bool susfs_is_current_droidspaces_domain(void);
+
 int susfs_get_non_sus_mnt_id_from_mnt(struct mount *orig_mnt)
 {
 	struct mount *mnt = orig_mnt;
 	int mnt_id;
 
+	/* DroidSpaces: daemon/kontainer droidspacesd melihat mount tree asli. */
+	if (susfs_is_current_droidspaces_domain())
+		return mnt->mnt_id;
+
 	if (mnt->mnt_id < DEFAULT_KSU_MNT_ID)
 		return mnt->mnt_id;
 
@@ -5021,6 +5027,13 @@ struct vfsmount *susfs_get_non_sus_vfsmnt_from_vfsmnt(struct vfsmount *vfsmnt)
 {
 	struct mount *mnt = real_mount(vfsmnt);
 
+	/* DroidSpaces: daemon/kontainer droidspacesd melihat vfsmount asli. */
+	if (susfs_is_current_droidspaces_domain()) {
+		mntget(&mnt->mnt);
+		dget(mnt->mnt.mnt_root);
+		return &mnt->mnt;
+	}
+
 	if (mnt->mnt_id < DEFAULT_KSU_MNT_ID) {
 		mntget(&mnt->mnt);
 		dget(mnt->mnt.mnt_root);

