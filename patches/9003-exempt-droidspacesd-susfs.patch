# 9003 (OPSIONAL) - Exempt domain `droidspacesd` dari SUSFS "hide sus mounts
# for non-su procs": daemon/kontainer DroidSpaces melihat mount tree asli,
# root-hiding app lain tetap bekerja. Disusun oleh `git diff` atas tree
# staging guacamole + fork KernelSU@fork (bentuk byte 100% generator resmi).
# Terapkan SETELAH folder KernelSU/ tersedia. Tanpa patch ini: biarkan toggle
# susfs pada posisi OFF (default kernel ini memang OFF).
diff --git a/KernelSU/kernel/selinux/selinux.c b/KernelSU/kernel/selinux/selinux.c
index 01d07ee..d4538bd 100644
--- a/KernelSU/kernel/selinux/selinux.c
+++ b/KernelSU/kernel/selinux/selinux.c
@@ -239,12 +239,15 @@ void escape_to_root_for_adb_root(void)
 #define KERNEL_ZYGOTE_DOMAIN "u:r:zygote:s0"
 #define KERNEL_ZYGOTE_NEXT_DOMAIN "u:r:zygote_next:s0"
 #define KERNEL_PRIV_APP_DOMAIN "u:r:priv_app:s0:c512,c768"
+/* Domain daemon DroidSpaces (droidspaces-oss boot-module) */
+#define KERNEL_DROIDSPACESD_DOMAIN "u:r:droidspacesd:s0"
 
 u32 susfs_ksu_sid __read_mostly = 0;
 u32 susfs_init_sid __read_mostly = 0;
 u32 susfs_zygote_sid __read_mostly = 0;
 u32 susfs_zygote_next_sid __read_mostly = 0;
 u32 susfs_priv_app_sid __read_mostly = 0;
+u32 susfs_droidspacesd_sid __read_mostly = 0;
 
 static inline void susfs_set_sid(const char *secctx_name, u32 *out_sid)
 {
@@ -315,6 +318,20 @@ bool susfs_is_current_init_domain(void) {
     return unlikely(current_sid() == susfs_init_sid);
 }
 
+/* - true hanya jika proses berjalan di domain droidspacesd
+ * - sid diresolusi lazy: domain bisa baru ada setelah policy DroidSpaces
+ *   dimuat backend (post-fs-data), sementara susfs_set_batch_sid()
+ *   berjalan lebih awal saat boot.
+ */
+bool susfs_is_current_droidspaces_domain(void) {
+    if (unlikely(!READ_ONCE(susfs_droidspacesd_sid))) {
+        susfs_set_sid(KERNEL_DROIDSPACESD_DOMAIN, &susfs_droidspacesd_sid);
+        if (!READ_ONCE(susfs_droidspacesd_sid))
+            return false;
+    }
+    return unlikely(current_sid() == READ_ONCE(susfs_droidspacesd_sid));
+}
+
 void susfs_set_batch_sid(void)
 {
     susfs_set_sid(KERNEL_ZYGOTE_DOMAIN, &susfs_zygote_sid);
@@ -322,4 +339,6 @@ void susfs_set_batch_sid(void)
     susfs_set_sid(KERNEL_SU_CONTEXT, &susfs_ksu_sid);
     susfs_set_sid(KERNEL_INIT_DOMAIN, &susfs_init_sid);
     susfs_set_sid(KERNEL_PRIV_APP_DOMAIN, &susfs_priv_app_sid);
+    /* Lazy-resolved saat pemakaian pertama (policy bisa dimuat lebih lambat) */
+    susfs_set_sid(KERNEL_DROIDSPACESD_DOMAIN, &susfs_droidspacesd_sid);
 }
diff --git a/fs/namespace.c b/fs/namespace.c
index 025b373..073ed5b 100644
--- a/fs/namespace.c
+++ b/fs/namespace.c
@@ -4993,11 +4993,17 @@ fs_initcall(init_fs_namespace_sysctls);
 
 #ifdef CONFIG_KSU_SUSFS
 /* - To retrieve the non sus mnt_id from mount */
+extern bool susfs_is_current_droidspaces_domain(void);
+
 int susfs_get_non_sus_mnt_id_from_mnt(struct mount *orig_mnt)
 {
 	struct mount *mnt = orig_mnt;
 	int mnt_id;
 
+	/* DroidSpaces: daemon/kontainer droidspacesd melihat mount tree asli. */
+	if (susfs_is_current_droidspaces_domain())
+		return mnt->mnt_id;
+
 	if (mnt->mnt_id < DEFAULT_KSU_MNT_ID)
 		return mnt->mnt_id;
 
@@ -5021,6 +5027,13 @@ struct vfsmount *susfs_get_non_sus_vfsmnt_from_vfsmnt(struct vfsmount *vfsmnt)
 {
 	struct mount *mnt = real_mount(vfsmnt);
 
+	/* DroidSpaces: daemon/kontainer droidspacesd melihat vfsmount asli. */
+	if (susfs_is_current_droidspaces_domain()) {
+		mntget(&mnt->mnt);
+		dget(mnt->mnt.mnt_root);
+		return &mnt->mnt;
+	}
+
 	if (mnt->mnt_id < DEFAULT_KSU_MNT_ID) {
 		mntget(&mnt->mnt);
 		dget(mnt->mnt.mnt_root);
